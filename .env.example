# Environment variables cleared reads, by name only.
# Never put a value in this file or in any committed file. Locally, copy the
# names you need into .env.local (git-ignored); on Vercel, set them in the
# project's environment settings.

# ── Database (groundwork for the pipeline; no route opens it yet) ──────────
# Postgres connection string (production: Neon's pooled endpoint). When unset,
# the app uses an embedded PGlite database at PGLITE_DATA_DIR (local only;
# never on Vercel, where an unset DATABASE_URL is an error).
DATABASE_URL=
# Unpooled connection string, used only by `pnpm db:migrate`. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Where the local PGlite database lives. Default: .data/pglite
PGLITE_DATA_DIR=

# ── Cron (slice S1) ──────────────────────────────────────────────────────────
# Shared secret Vercel sends as "Authorization: Bearer <CRON_SECRET>" to
# /api/cron/tick. Without it the route answers 401 and runs nothing.
CRON_SECRET=

# ── Already in use before the rebuild ────────────────────────────────────────
# Upstash Redis: anonymous interest pool and rate limits (lib/signal/store.ts).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional GitHub token for verify_evidence's public-code lookups (lib/github/client.ts).
GITHUB_TOKEN=

# ── Named by the design for later slices (not read yet) ──────────────────────
# Mail (S2): the transactional mail service's key. Without it the null sender runs.
# RESEND_API_KEY=
# AI judging (S6): the Anthropic key; JUDGE_MODE (model | stand_in); JUDGE_MODEL
# (default claude-opus-5-5); AI_DAILY_BUDGET_USD (default 25).
# ANTHROPIC_API_KEY=
# JUDGE_MODE=
# JUDGE_MODEL=
# AI_DAILY_BUDGET_USD=
# Background checks (S12): 32-byte key that encrypts provider access tokens
# (AES-256-GCM); ALLOW_SIMULATOR=1 enables the provider simulator pages.
# PROVIDER_TOKEN_KEY=
# ALLOW_SIMULATOR=
